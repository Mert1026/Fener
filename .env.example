# Setup fills these with a unique local credential. Never commit your .env.
DATABASE_URL=
POSTGRES_PASSWORD=
FENER_POSTGRES_PORT=5432
FENER_ADMIN_KEY=
FENER_APP_MODE=private
FENER_SNAPSHOT_DIR=.data/snapshots
FENER_API_URL=http://127.0.0.1:8000
ZAI_API_KEY=
FENER_ZAI_RESEARCH_MODEL=glm-4.7-flash
FENER_RESEARCH_DAILY_LIMIT=5
FENER_SYNC_INTERVAL_SECONDS=21600
AUTO_APPLY_RECOMMENDATIONS=false
# Server deployments: the worker syncs every FENER_SYNC_INTERVAL_SECONDS
# (set 18000 for every 5 hours). Manual per-source "Queue sync" buttons are
# always available on the Data health page.
FENER_WEB_ORIGIN=
# Set FENER_WEB_ORIGIN to the exact URL you open in the browser when serving
# the web UI from a container on another interface (e.g. http://fener:3000
# over Tailscale). Leave empty for local 127.0.0.1/localhost use.
TS_AUTHKEY=
TS_HOSTNAME=fener
