# Setup fills these with a unique local credential. Never commit your .env.
DATABASE_URL=
POSTGRES_PASSWORD=
FENER_POSTGRES_PORT=5432
FENER_ADMIN_KEY=
FENER_APP_MODE=private
FENER_SNAPSHOT_DIR=.data/snapshots
FENER_API_URL=http://127.0.0.1:8000
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ZAI_API_KEY=
FENER_RESEARCH_PROVIDER=openai
FENER_ZAI_RESEARCH_MODEL=glm-4.7-flash
FENER_RESEARCH_MODEL=gpt-5.4-mini
FENER_RESEARCH_DAILY_LIMIT=5
LLM_STATS_API_KEY=
FENER_SYNC_INTERVAL_SECONDS=21600
FENER_OPENROUTER_ENDPOINT_LIMIT=20
AUTO_APPLY_RECOMMENDATIONS=false
